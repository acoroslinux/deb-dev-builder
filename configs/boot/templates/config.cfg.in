# Load video and graphical modules
if [ -e "${prefix}/${grub_cpu}-${grub_platform}/all_video.mod" ]; then
    insmod all_video
else
    insmod efi_gop
    insmod efi_uga
    insmod video_bochs
    insmod video_cirrus
fi

insmod font
insmod png
insmod part_gpt
insmod part_msdos
insmod fat
insmod iso9660
insmod ext2

# Load font and setup terminal output
if loadfont /boot/grub/unicode.pf2 ; then
    set gfxmode=auto
    insmod gfxterm
    terminal_output gfxterm
fi
