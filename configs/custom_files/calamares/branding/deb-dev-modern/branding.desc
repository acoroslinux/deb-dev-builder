slideshow: "show.qml"
slideshowAPI: 2

style:
    SidebarBackground: "#1A1C1E"
    SidebarText: "#8C92AC"
    SidebarTextCurrent: "#47A7F5"
    SidebarBackgroundCurrent: "#24292F"
    sidebarBackground: "#1A1C1E"
    sidebarText: "#8C92AC"
    sidebarTextSelect: "#47A7F5"
    sidebarTextHighlight: "#9E00FF"
